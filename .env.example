# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Supabase > Project Settings > API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave PUBLICÁVEL (sb_publishable_...) ou a "anon" antiga. NUNCA a service_role / secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Endereço público do site (sem barra no final). Ex.: https://acuniversodoscabelos.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
